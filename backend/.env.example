# ---------- Required ----------

# MongoDB connection string. From MongoDB Atlas: Database > Connect > Drivers.
# Put the database name (devTinder) before the "?" like below.
DB_CONNECTION_SECRET=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/devTinder?retryWrites=true&w=majority

# Any long random string. Make one on your Mac with:  openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string

# ---------- Optional ----------

# Port for the API on your Mac. Render sets its own PORT, so leave it out there.
PORT=7777

# Where the frontend runs. Comma separate more than one.
FRONTEND_URL=http://localhost:5173

# Set to "production" on Render (makes the login cookie https-only).
# NODE_ENV=production

# AWS SES email (optional). When AWS_ACCESS_KEY, AWS_SECRET_KEY and SES_FROM_EMAIL are set,
# people get an email when someone is interested in them, plus a daily 8 AM reminder.
# SES_FROM_EMAIL must be an address or domain you verified in Amazon SES.
# AWS_ACCESS_KEY=
# AWS_SECRET_KEY=
# AWS_REGION=ap-south-1
# SES_FROM_EMAIL=you@yourdomain.com
